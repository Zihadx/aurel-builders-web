# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://aurelroofing.example.com"

# Where estimate requests and bookings are delivered (https only; private
# addresses are rejected). The handler POSTs the validated lead as JSON.
# Leave empty and the forms still validate but report that nothing was sent.
LEAD_WEBHOOK_URL=""

# Optional but recommended: shared secret (16+ chars). When set, each webhook
# request carries X-Aurel-Signature: sha256=<hmac of the body>, so your
# receiver can verify it really came from this site.
LEAD_WEBHOOK_SECRET=""

# WhatsApp number for the chat button (digits only, international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER="18005550194"
